#:import ButtonBehavior kivy.uix.behaviors.ButtonBehavior
#:import MDCard kivymd.uix.card.MDCard
#:import MDTopAppBar kivymd.uix.toolbar.MDTopAppBar


# ---------------------------------------------------------------------------
# Reusable templates
# ---------------------------------------------------------------------------

<SemesterCard@ButtonBehavior+MDCard>:
    semester_num: 1
    has_file: False
    orientation: "vertical"
    padding: "16dp"
    size_hint_y: None
    height: "150dp"
    radius: [22, 22, 22, 22]
    elevation: 10 if self.has_file else 2
    md_bg_color: (0.11, 0.16, 0.36, 1) if self.has_file else (0.93, 0.94, 0.97, 1)

    MDLabel:
        text: "Semester"
        font_style: "Caption"
        size_hint_y: None
        height: self.texture_size[1]
        theme_text_color: "Custom"
        text_color: (1, 1, 1, 0.75) if root.has_file else (0.15, 0.18, 0.3, 0.6)

    MDLabel:
        text: str(root.semester_num)
        font_style: "H3"
        bold: True
        size_hint_y: None
        height: self.texture_size[1]
        theme_text_color: "Custom"
        text_color: (1, 1, 1, 1) if root.has_file else (0.1, 0.12, 0.25, 1)

    Widget:

    MDBoxLayout:
        size_hint_y: None
        height: "26dp"
        spacing: "6dp"
        MDIcon:
            icon: "check-circle" if root.has_file else "cloud-off-outline"
            size_hint_x: None
            width: "20dp"
            theme_text_color: "Custom"
            text_color: (0.3, 0.9, 0.6, 1) if root.has_file else (0.5, 0.5, 0.6, 0.7)
        MDLabel:
            text: "Ready" if root.has_file else "Empty"
            bold: True
            font_style: "Caption"
            theme_text_color: "Custom"
            text_color: (0.3, 0.9, 0.6, 1) if root.has_file else (0.5, 0.5, 0.6, 0.7)


<SettingsRow@MDCard>:
    semester_num: 1
    has_file: False
    file_name: ""
    orientation: "horizontal"
    padding: "12dp"
    spacing: "12dp"
    size_hint_y: None
    height: "76dp"
    radius: [18, 18, 18, 18]
    elevation: 2

    MDLabel:
        text: str(root.semester_num)
        bold: True
        halign: "center"
        size_hint_x: None
        width: "40dp"
        theme_text_color: "Custom"
        text_color: (0.2, 0.75, 0.55, 1) if root.has_file else (0.4, 0.4, 0.5, 1)

    MDBoxLayout:
        orientation: "vertical"
        MDLabel:
            text: f"Semester {root.semester_num}"
            bold: True
        MDLabel:
            text: root.file_name
            font_style: "Caption"
            shorten: True
            shorten_from: "right"
            theme_text_color: "Secondary"

    MDIconButton:
        id: remove_btn
        icon: "delete-outline"
        theme_text_color: "Custom"
        text_color: (0.9, 0.3, 0.3, 1)
        disabled: not root.has_file
        opacity: 1 if root.has_file else 0

    MDRaisedButton:
        id: upload_btn
        text: "Change" if root.has_file else "Upload"
        md_bg_color: 0.30, 0.55, 1, 1


<ThemeOptionRow@ButtonBehavior+MDCard>:
    mode_value: "Light"
    label_text: "Light"
    icon_name: "white-balance-sunny"
    selected: False
    orientation: "horizontal"
    padding: "14dp"
    spacing: "14dp"
    size_hint_y: None
    height: "64dp"
    radius: [18, 18, 18, 18]
    elevation: 6 if self.selected else 1
    md_bg_color: (0.30, 0.55, 1, 0.18) if root.selected else (1, 1, 1, 1)

    MDIcon:
        icon: root.icon_name
        size_hint_x: None
        width: "28dp"
        theme_text_color: "Custom"
        text_color: 0.30, 0.55, 1, 1

    MDLabel:
        text: root.label_text
        bold: True

    MDIcon:
        icon: "check-circle" if root.selected else "circle-outline"
        size_hint_x: None
        width: "24dp"
        theme_text_color: "Custom"
        text_color: (0.2, 0.8, 0.5, 1) if root.selected else (0.6, 0.6, 0.6, 1)


# ---------------------------------------------------------------------------
# Screens
# ---------------------------------------------------------------------------

ScreenManager:
    HomeScreen:
    SettingsScreen:
    ThemeScreen:


<HomeScreen>:
    name: "home"
    MDBoxLayout:
        orientation: "vertical"

        MDTopAppBar:
            title: "Books.IGNOU"
            elevation: 4
            right_action_items: [["dots-vertical", lambda x: app.open_menu(x)]]

        ScrollView:
            MDBoxLayout:
                orientation: "vertical"
                padding: "20dp"
                spacing: "16dp"
                size_hint_y: None
                height: self.minimum_height

                MDLabel:
                    text: "Namaste"
                    font_style: "H5"
                    bold: True
                    size_hint_y: None
                    height: self.texture_size[1]

                MDLabel:
                    text: "Apna semester chunein aur padhai shuru karein"
                    theme_text_color: "Secondary"
                    size_hint_y: None
                    height: self.texture_size[1]

                MDGridLayout:
                    id: semester_grid
                    cols: 2
                    spacing: "14dp"
                    size_hint_y: None
                    height: self.minimum_height


<SettingsScreen>:
    name: "settings"
    MDBoxLayout:
        orientation: "vertical"

        MDTopAppBar:
            title: "Settings"
            elevation: 4
            left_action_items: [["arrow-left", lambda x: app.menu_go("home")]]
            right_action_items: [["dots-vertical", lambda x: app.open_menu(x)]]

        ScrollView:
            MDBoxLayout:
                orientation: "vertical"
                padding: "20dp"
                spacing: "12dp"
                size_hint_y: None
                height: self.minimum_height

                MDLabel:
                    text: "Har semester ke liye ek file (PDF/doc) upload karein. File phone me hi rehti hai, sab kuch offline hai."
                    theme_text_color: "Secondary"
                    size_hint_y: None
                    height: self.texture_size[1]

                MDBoxLayout:
                    id: settings_list
                    orientation: "vertical"
                    spacing: "12dp"
                    size_hint_y: None
                    height: self.minimum_height


<ThemeScreen>:
    name: "theme"
    MDBoxLayout:
        orientation: "vertical"

        MDTopAppBar:
            title: "Theme"
            elevation: 4
            left_action_items: [["arrow-left", lambda x: app.menu_go("home")]]
            right_action_items: [["dots-vertical", lambda x: app.open_menu(x)]]

        MDBoxLayout:
            orientation: "vertical"
            padding: "20dp"
            spacing: "12dp"

            MDLabel:
                text: "Apna pasandida look chunein"
                theme_text_color: "Secondary"
                size_hint_y: None
                height: self.texture_size[1]

            MDBoxLayout:
                id: theme_list
                orientation: "vertical"
                spacing: "12dp"
                size_hint_y: None
                height: self.minimum_height

                ThemeOptionRow:
                    mode_value: "Light"
                    label_text: "Light"
                    icon_name: "white-balance-sunny"
                    on_release: app.set_theme("Light")

                ThemeOptionRow:
                    mode_value: "Dark"
                    label_text: "Dark"
                    icon_name: "weather-night"
                    on_release: app.set_theme("Dark")

                ThemeOptionRow:
                    mode_value: "System"
                    label_text: "System Default"
                    icon_name: "cellphone"
                    on_release: app.set_theme("System")

            Widget:
